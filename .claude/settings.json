{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh project list *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh label list *)",
      "Bash(gh api repos/Datata1/AWP2/milestones *)",
      "Bash(python3 .claude/scripts/board.py *)",
      "Bash(python3 tools/timesheet.py *)",
      "Bash(gh search *)",
      "Bash(gh api user *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Edit(data/raw/**)",
      "Write(data/raw/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_raw_data.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/timesheet.py\"; [ ! -f \"$f\" ] || python3 \"$f\" missing --hook"
          }
        ]
      }
    ]
  }
}
